    "def test_equivalence(n_tests=10):\n",
    "    for _ in range(n_tests):\n",
    "        theta = np.random.uniform(0, 2*np.pi)\n",
    "\n",
    "        qc1 = QuantumCircuit(1)\n",
    "        qc1.h(0)\n",
    "        qc1.rz(theta, 0)\n",
    "        qc1.h(0)\n",
    "\n",
    "        qc2 = QuantumCircuit(1)\n",
    "        qc2.rx(theta, 0)\n",
    "\n",
    "        if not Operator(qc1).equiv(Operator(qc2)):\n",
    "            return False\n",
    "\n",
    "    return True\n",
    "\n",
    "print(test_equivalence(20))"
   ]
