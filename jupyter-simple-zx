     ]
    }
   ],
   "source": [
    "# backend (simulator)\n",
    "backend = Aer.get_backend('statevector_simulator')\n",
    "\n",
    "# compile circuit\n",
    "compiled = transpile(qc, backend)\n",
    "\n",
    "# run\n",
    "result = backend.run(compiled).result()\n",
    "\n",
    "# get statevector\n",
    "state = result.get_statevector()\n",
    "print(state)"
   ]
