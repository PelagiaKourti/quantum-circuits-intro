   "source": [
    "#create a circuit with 1 qubit\n",
    "qc = QuantumCircuit(1)\n",
    "\n",
    "#add a rotation Rz(\\pi /2)   (of \\pi / 2 around the z-axis of the Bloch sphere )\n",
    "qc.rz(np.pi/2, 0)\n",
    "\n",
    "#add Hadamard gate\n",
    "qc.h(0)\n",
    "\n",
    "#print the circuit\n",
    "qc.draw('mpl')"
   ]
